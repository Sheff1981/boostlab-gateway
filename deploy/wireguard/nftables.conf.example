table inet boostlab_filter {
    chain forward {
        type filter hook forward priority filter; policy drop;

        ct state invalid drop
        ct state established,related accept

        # Only BOOSTLAB tunnel clients may forward to the public interface.
        iifname "wg0" oifname "<WAN_IFACE>" ip saddr 10.77.0.0/24 accept
    }
}

table ip boostlab_nat {
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;

        # NAT only the dedicated BOOSTLAB tunnel subnet.
        oifname "<WAN_IFACE>" ip saddr 10.77.0.0/24 masquerade
    }
}
