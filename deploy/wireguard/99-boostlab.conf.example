# BOOSTLAB WireGuard forwarding baseline.
# Install as /etc/sysctl.d/99-boostlab.conf and run: sysctl --system

# Required for phone -> WireGuard -> Internet forwarding.
net.ipv4.ip_forward = 1

# Keep enough UDP socket buffer headroom for WireGuard/probes without extreme tuning.
net.core.rmem_max = 8388608
net.core.wmem_max = 8388608
net.core.rmem_default = 262144
net.core.wmem_default = 262144
