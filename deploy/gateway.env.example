BOOSTLAB_NODE_ID=eu-test-1
BOOSTLAB_REGION=eu-test
BOOSTLAB_HTTP_ADDR=:8080
BOOSTLAB_UDP_ADDR=:51821
BOOSTLAB_WG_PORT=51820
# Set only the PUBLIC key after WireGuard is initialized.
# BOOSTLAB_WG_PUBLIC_KEY=<SERVER_PUBLIC_KEY>


# Allowlisted game endpoints used only for route-quality measurements.
# Keep this JSON in sync with boostlab-control.
# Example:
# BOOSTLAB_GAME_ROUTES_JSON=[{"id":"game-eu-1","host":"game.example.com","tcp_port":443}]
BOOSTLAB_GAME_ROUTES_JSON=


# Automatic Android peer provisioning.
# Use the exact same 32+ byte secret in boostlab-control.
# Generate one with: openssl rand -hex 32
BOOSTLAB_PROVISIONING_SECRET=
BOOSTLAB_WG_INTERFACE=wg0
BOOSTLAB_TUNNEL_CIDR=10.77.0.0/24
BOOSTLAB_WG_PERSIST_PEERS=true
BOOSTLAB_PEER_DATA_FILE=/var/lib/boostlab/peers.json


# Remove provisioned WireGuard peers that have been inactive for 30 days.
# A phone can register itself again automatically on the next connection.
BOOSTLAB_PEER_STALE_HOURS=720
BOOSTLAB_PEER_SWEEP_MINUTES=60
